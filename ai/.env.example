# ---- People directory (PostgreSQL) ----
# Where the matcher reads universities, industries and their people from. Set this explicitly:
# the fallback of reading frontend/.env off local disk cannot work once the two services are
# deployed separately. Keep sslmode=require so the connection can never silently fall back to
# plaintext. channel_binding=require is supported by psycopg but NOT by Prisma, so the frontend's
# copy of this URL must leave it off.
DATABASE_URL=

# ---- Where problem state lives ----
# Unset (the default) keeps problems, notifications, milestones and the points ledger in a local
# SQLite file, which is fine on one machine but invisible to every other one. Set this to a
# PostgreSQL URL and that state moves to the database instead, so every deployment shares it.
# The tables go in their own schema (PROBLEM_DB_SCHEMA, default "ai") because `problems` and
# `project_members` already exist in the Prisma schema that owns users and organizations.
PROBLEM_DB_URL=
PROBLEM_DB_SCHEMA=ai

# ---- Where state lives ----
# Both default to ./data, which is fine on a laptop. In a container they must point at a mounted
# disk, or every deploy starts from an empty database and previously uploaded evidence 404s.
PROBLEM_DB_PATH=
UPLOAD_DIR=

# ---- Browser access ----
# Comma-separated list of the exact frontend origins allowed to call this API.
# Defaults to the local dev ports. Never use "*": combined with credentials browsers reject it,
# and it would let any website on the internet call this API as a signed-in visitor.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

GEMINI_API_KEY=your_key_here
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_VISION_MODEL=gemini-3.5-flash-lite

# ---- Notifications (see NOTIFICATIONS.md) ----
# Leave everything below blank to run notifications in dry-run/mock mode
# (logs what would be sent, sends nothing for real -- safe default).

# Email (SMTP) -- e.g. Gmail with an app password:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=youraddress@gmail.com
#   SMTP_PASSWORD=your_16_char_app_password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# SMS provider: "mock" (default, dry-run), "twilio", or "http"
SMS_PROVIDER=mock

# Twilio (used if SMS_PROVIDER=twilio) -- also run: pip install twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Generic HTTP SMS gateway, e.g. MSG91 / Fast2SMS (used if SMS_PROVIDER=http)
# -- payload shape in notification_service.py is generic; check your
# provider's docs and adjust send_sms() if their API expects different keys.
SMS_HTTP_URL=
SMS_HTTP_API_KEY=
SMS_HTTP_SENDER_ID=

# ---- Object storage (Cloudflare R2, or any S3-compatible service) ----
# Where uploaded evidence and workspace attachments live. Leave unset and files are written under
# UPLOAD_DIR on local disk, which is fine on one machine but breaks the moment the database is
# shared: a record written on one laptop hands every other machine a link to a file that only ever
# existed on the first one. Keep the bucket PRIVATE -- these are citizens' evidence files, and the
# API streams them to signed-in users rather than handing out public URLs.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
