.env
.env.*
!.env.example
# Claude Code local settings
.claude/

# -------------------------------------------------
#  Python (ai/)
# -------------------------------------------------
ai/.venv/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# -------------------------------------------------
#  Node / Next.js (frontend/)
# -------------------------------------------------
node_modules/
.next/
*.tsbuildinfo

# -------------------------------------------------
#  Runtime data generated by running the app
# -------------------------------------------------
# The FastAPI SQLite database, its backups and journals, and files users upload. Recreate demo data
# with `npm run db:seed` / `npm run db:seed:people` (frontend) and seed_demo_data.py /
# seed_open_problems.py (ai). The seed data files in ai/data/*.json stay tracked.
ai/data/*.sqlite3
ai/data/*.sqlite3.*
ai/data/*.sqlite3-journal
ai/data/*.sqlite3-wal
ai/data/*.sqlite3-shm
ai/data/uploads/
*.log

